# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Only the semantic path reads any of this. The deterministic path — exact lookup over
# knowledge/ — needs none of it and makes no network call.

# Required. The Elasticsearch endpoint and an API key for it. Never logged, never committed.
ES_URL=
ES_API_KEY=

# Optional. The index every command reads and writes.
# Default: grounded-context-corpus
#ES_INDEX=my-team-corpus

# Optional. The inference endpoint the index mapping is built against.
# Default: .elser-2-elasticsearch — preconfigured on Elastic Cloud Serverless, and the one
# this project uses: ELSER running on your own cluster's ML nodes, scaled by adaptive
# allocations down to zero when idle.
#
# Careful — a deployment also ships `.elser-2-elastic`, one word away. That is the same model
# served by the Elastic Inference Service: managed by Elastic, off your nodes, billed per use.
# Both are valid; they are different places to run the inference, not different quality. Pick
# deliberately, because the id is baked into the mapping at index-creation time, so changing it
# later is an index you rebuild rather than a setting you edit. List what a project actually has:
#   uv run --extra es python -c "from grounded_context.es_client import client; \
#     print([e['inference_id'] for e in client().inference.get()['endpoints']])"
#
# A self-managed cluster names its own: elser_v2, or whatever
# `PUT _inference/sparse_embedding/<id>` created. Set this before `index_corpus.py` runs.
#ES_INFERENCE_ID=elser_v2
